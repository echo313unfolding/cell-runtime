{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oracle Signal",
  "description": "Mock oracle signal for price/risk data. Not a real oracle. A structured signal consumed by the regulated asset adapter for risk calculation.",

  "type": "object",
  "required": ["signal_id", "signal_type", "timestamp", "value"],
  "properties": {
    "signal_id": {
      "type": "string",
      "description": "Unique signal identifier"
    },
    "signal_type": {
      "type": "string",
      "enum": ["price", "volatility", "liquidity", "risk_score", "sanctions_list_update"],
      "description": "Type of oracle signal"
    },
    "asset_type": {
      "type": "string",
      "description": "Asset this signal applies to"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "value": {
      "type": "number",
      "description": "Signal value (price in USD, volatility %, risk score 0-100)"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Signal confidence (0-1)"
    },
    "source": {
      "type": "string",
      "description": "Data source identifier"
    }
  }
}

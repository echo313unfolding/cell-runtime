root ::= plan
plan ::= "{" ws "\"name\"" ws ":" ws string "," ws "\"ops\"" ws ":" ws "[" ws ops ws "]" ws "}"
ops ::= op | op "," ws ops
op ::= seed-op | emit-op | bloom-op | flow-op | for-each-op | cycle-op | weave-op | when-op | else-op | use-op | pack-op
seed-op ::= "{" ws "\"op\"" ws ":" ws "\"seed\"" "," ws "\"name\"" ws ":" ws identifier "," ws "\"value\"" ws ":" ws value ws "}"
emit-op ::= "{" ws "\"op\"" ws ":" ws "\"emit\"" "," ws "\"value\"" ws ":" ws value ws "}"
bloom-op ::= "{" ws "\"op\"" ws ":" ws "\"bloom\"" "," ws "\"value\"" ws ":" ws value ws "}"
flow-op ::= "{" ws "\"op\"" ws ":" ws "\"flow\"" "," ws "\"name\"" ws ":" ws identifier "," ws "\"output\"" ws ":" ws identifier ws "}"
for-each-op ::= "{" ws "\"op\"" ws ":" ws "\"for_each\"" "," ws "\"name\"" ws ":" ws identifier "," ws "\"value\"" ws ":" ws identifier "," ws "\"children\"" ws ":" ws "[" ws ops ws "]" ws "}"
cycle-op ::= "{" ws "\"op\"" ws ":" ws "\"cycle\"" "," ws "\"count\"" ws ":" ws value "," ws "\"accumulator\"" ws ":" ws identifier "," ws "\"init\"" ws ":" ws value "," ws "\"iter_var\"" ws ":" ws identifier "," ws "\"body_expr\"" ws ":" ws expr ws cycle-children-opt "}"
cycle-children-opt ::= "" | "," ws "\"children\"" ws ":" ws "[" ws ops ws "]"
weave-op ::= "{" ws "\"op\"" ws ":" ws "\"weave\"" "," ws "\"inputs\"" ws ":" ws "[" ws identifiers ws "]" "," ws "\"expr\"" ws ":" ws expr "," ws "\"output\"" ws ":" ws identifier ws weave-type-opt "}"
weave-type-opt ::= "" | "," ws "\"result_type\"" ws ":" ws dtype
when-op ::= "{" ws "\"op\"" ws ":" ws "\"when\"" "," ws "\"condition\"" ws ":" ws expr "," ws "\"children\"" ws ":" ws "[" ws ops ws "]" ws "}"
else-op ::= "{" ws "\"op\"" ws ":" ws "\"else\"" "," ws "\"children\"" ws ":" ws "[" ws ops ws "]" ws "}"
use-op ::= "{" ws "\"op\"" ws ":" ws "\"use\"" "," ws "\"tool\"" ws ":" ws string ws use-params-opt "}"
use-params-opt ::= "" | "," ws "\"params\"" ws ":" ws "{" ws kv-pairs ws "}"
pack-op ::= "{" ws "\"op\"" ws ":" ws "\"pack\"" "," ws "\"name\"" ws ":" ws identifier "," ws "\"format\"" ws ":" ws pack-format ws "}"
identifier ::= "\"" [a-zA-Z_] [a-zA-Z0-9_]* "\""
identifiers ::= identifier | identifier "," ws identifiers
string ::= "\"" [^"\\]* "\""
value ::= string | number | "true" | "false" | "null" | "[" ws values ws "]"
values ::= value | value "," ws values |
number ::= "-"? [0-9]+ ("." [0-9]+)?
dtype ::= "\"int\"" | "\"float\"" | "\"bool\"" | "\"string\"" | "\"list\"" | "\"any\""
pack-format ::= "\"json\"" | "\"csv\"" | "\"text\""
kv-pairs ::= kv-pair | kv-pair "," ws kv-pairs
kv-pair ::= string ws ":" ws value
ws ::= [ \t\n]*

# Expression rules (generated from ExprKind enum)
expr ::= lit-expr | var-expr | add-expr | sub-expr | mul-expr | div-expr | mod-expr | gt-expr | lt-expr | gte-expr | lte-expr | eq-expr | neq-expr | neg-expr | not-expr | cond-expr | index-expr | call-expr
lit-expr ::= "{" ws "\"kind\"" ws ":" ws "\"lit\"" "," ws "\"value\"" ws ":" ws value ws "}"
var-expr ::= "{" ws "\"kind\"" ws ":" ws "\"var\"" "," ws "\"name\"" ws ":" ws identifier ws "}"
add-expr ::= "{" ws "\"kind\"" ws ":" ws "\"add\"" "," ws "\"left\"" ws ":" ws expr "," ws "\"right\"" ws ":" ws expr ws "}"
sub-expr ::= "{" ws "\"kind\"" ws ":" ws "\"sub\"" "," ws "\"left\"" ws ":" ws expr "," ws "\"right\"" ws ":" ws expr ws "}"
mul-expr ::= "{" ws "\"kind\"" ws ":" ws "\"mul\"" "," ws "\"left\"" ws ":" ws expr "," ws "\"right\"" ws ":" ws expr ws "}"
div-expr ::= "{" ws "\"kind\"" ws ":" ws "\"div\"" "," ws "\"left\"" ws ":" ws expr "," ws "\"right\"" ws ":" ws expr ws "}"
mod-expr ::= "{" ws "\"kind\"" ws ":" ws "\"mod\"" "," ws "\"left\"" ws ":" ws expr "," ws "\"right\"" ws ":" ws expr ws "}"
gt-expr ::= "{" ws "\"kind\"" ws ":" ws "\"gt\"" "," ws "\"left\"" ws ":" ws expr "," ws "\"right\"" ws ":" ws expr ws "}"
lt-expr ::= "{" ws "\"kind\"" ws ":" ws "\"lt\"" "," ws "\"left\"" ws ":" ws expr "," ws "\"right\"" ws ":" ws expr ws "}"
gte-expr ::= "{" ws "\"kind\"" ws ":" ws "\"gte\"" "," ws "\"left\"" ws ":" ws expr "," ws "\"right\"" ws ":" ws expr ws "}"
lte-expr ::= "{" ws "\"kind\"" ws ":" ws "\"lte\"" "," ws "\"left\"" ws ":" ws expr "," ws "\"right\"" ws ":" ws expr ws "}"
eq-expr ::= "{" ws "\"kind\"" ws ":" ws "\"eq\"" "," ws "\"left\"" ws ":" ws expr "," ws "\"right\"" ws ":" ws expr ws "}"
neq-expr ::= "{" ws "\"kind\"" ws ":" ws "\"neq\"" "," ws "\"left\"" ws ":" ws expr "," ws "\"right\"" ws ":" ws expr ws "}"
neg-expr ::= "{" ws "\"kind\"" ws ":" ws "\"neg\"" "," ws "\"operand\"" ws ":" ws expr ws "}"
not-expr ::= "{" ws "\"kind\"" ws ":" ws "\"not\"" "," ws "\"operand\"" ws ":" ws expr ws "}"
cond-expr ::= "{" ws "\"kind\"" ws ":" ws "\"cond\"" "," ws "\"test\"" ws ":" ws expr "," ws "\"true\"" ws ":" ws expr "," ws "\"false\"" ws ":" ws expr ws "}"
index-expr ::= "{" ws "\"kind\"" ws ":" ws "\"index\"" "," ws "\"target\"" ws ":" ws identifier "," ws "\"idx\"" ws ":" ws expr ws "}"
call-expr ::= "{" ws "\"kind\"" ws ":" ws "\"call\"" "," ws "\"fn\"" ws ":" ws builtin-name "," ws "\"args\"" ws ":" ws "[" ws expr-list ws "]" ws "}"
builtin-name ::= "\"abs\"" | "\"concat\"" | "\"len\""
expr-list ::= expr | expr "," ws expr-list |